{
  "homepage": "https://jasytech.github.io/jasyweb",
  "name": "jasytech-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predeploy": "npm run check",
    "deploy": "gh-pages -d dist",
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "check": "npm run format:check && npm run build && npm test"
  },
  "dependencies": {
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "gh-pages": "6.3.0",
    "prettier": "3.9.9",
    "vite": "8.3.0",
    "@vitejs/plugin-react": "6.1.1"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
